      {
        "name": "namespace",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(docify_http_requests_total, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(docify_http_requests_total, namespace)",
        "regex": "/docify-.*/",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
