# Local development defaults (copy to .env). Never put real secrets in this file.
ENV=local
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://docify:docify@localhost:55432/docify
VALKEY_URL=redis://localhost:56379/0
AI_MODE=fake
STORAGE_BACKEND=local
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
AWS_ENDPOINT_URL_SQS=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/docify-local-events
SQS_DLQ_URL=http://localhost:9324/000000000000/docify-local-events-dlq
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
LOG_JSON=false

# Optional: GitHub "Docify Dev" App + Google OAuth (see docs/Docify_Master_Doc.md §9.1, §10.2)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: real AI (AI_MODE=real)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
